# ---------------------------------------------------------------------------
# SmartCompress Pro - example environment configuration
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# --- Django core -----------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# Comma separated list of trusted origins, e.g.
# CSRF_TRUSTED_ORIGINS=https://smartcompress.example.com

# --- Upload / processing limits (bytes) ------------------------------------
# 4 GB absolute upload ceiling; requests above 2.5 MB stream to disk.
MAX_UPLOAD_SIZE=4294967296
DATA_UPLOAD_MAX_MEMORY_SIZE=4294967296
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
CHUNK_UPLOAD_SIZE=5242880
TEMP_CLEANUP_AGE=86400

# --- Celery / Redis --------------------------------------------------------
# Set CELERY_EAGER=False in production and run a worker + Redis broker.
CELERY_EAGER=True
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_TIME_LIMIT=1800

# --- Rate limiting ---------------------------------------------------------
RATELIMIT_COMPRESS=120/h

# --- Optional: Ghostscript for advanced PDF compression --------------------
# Absolute path to gswin64c.exe / gs. Leave blank to auto-detect on PATH.
GHOSTSCRIPT_BINARY=

# --- Optional: LibreOffice for document format conversion ------------------
# Needed for DOCX/XLSX/PPTX -> PDF (and between office formats).
# Absolute path to soffice.exe. Leave blank to auto-detect on PATH.
LIBREOFFICE_BINARY=
